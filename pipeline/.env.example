# Copy this file to  pipeline/.env  and fill in your keys.
# pipeline/.env is gitignored — never commit real keys.

# --- ElevenLabs (your cloned voice) -------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=            # the voice id of your cloned voice
# Optional tuning:
ELEVEN_MODEL_ID=eleven_multilingual_v2
ELEVEN_OUTPUT_FORMAT=mp3_44100_128
ELEVEN_STABILITY=0.5
ELEVEN_SIMILARITY=0.8
ELEVEN_STYLE=0.0
ELEVEN_SPEAKER_BOOST=true
ELEVEN_MAX_CHARS=2500          # chunk size for long scenes

# --- HeyGen (your avatar/clone) -----------------------------------------
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=              # your avatar id OR talking-photo id
HEYGEN_AVATAR_TYPE=avatar      # 'avatar' (instant avatar) or 'talking_photo'
HEYGEN_AVATAR_STYLE=normal
# HEYGEN_BACKGROUND_COLOR=#008000   # optional; leave unset for default

# --- Claude (show notes / titles / description) -------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Assembly defaults (overridable per-lecture via edl.json) -----------
AVATAR_SCALE=0.28              # avatar PiP width as fraction of frame width
AVATAR_POSITION=bottom-right   # bottom-right | bottom-left | top-right | top-left
AVATAR_MARGIN=40
BG_COLOR=0x101418
